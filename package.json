{
  "name": "lulu",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build --mode app && vite build --mode demo",
    "test": "node --experimental-strip-types --test src/domain/transform.test.ts",
    "guard:firebase": "node scripts/firebase-guard.mjs",
    "test:firebase-guard": "node --test tests/firebase-guard.test.mjs",
    "dev:demo": "vite --host 127.0.0.1 --port 5174",
    "build:app": "tsc -b && vite build --mode app && node scripts/verify-mobile-package.mjs",
    "build:demo": "tsc -b && vite build --mode demo",
    "test:demo": "node --experimental-strip-types --test demo/src/domain/transform.test.ts",
    "build:hosted": "npm run build:app && node scripts/package-hosting.mjs",
    "native:sync": "npm run build:app && cap sync",
    "native:ios": "npm run build:app && cap sync ios && cap build ios",
    "native:android": "npm run build:app && cap sync android && cap build android",
    "native:open:ios": "cap open ios",
    "native:open:android": "cap open android"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/camera": "^8.2.6",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@huggingface/tokenizers": "0.2.0",
    "@simplewebauthn/browser": "^14.0.0",
    "firebase": "^12.19.0",
    "framer-motion": "^14.7.1",
    "lucide-react": "^0.468.0",
    "onnxruntime-web": "1.25.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "thinking-orbs": "^0.3.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "fake-indexeddb": "^6.2.6",
    "typescript": "^5.8.3",
    "vite": "^6.2.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6",
    "@firebase/app": "0.16.4",
    "@firebase/app-compat": "0.5.20"
  }
}
