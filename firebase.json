{
  "hosting": {
    "public": "dist/app",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "site": "khora-lulu-2026",
    "predeploy": [
      "node scripts/firebase-guard.mjs"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "headers": [
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=31536000,immutable"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json",
    "predeploy": [
      "node scripts/firebase-guard.mjs"
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "lulu",
      "runtime": "nodejs22",
      "predeploy": [
        "node scripts/firebase-guard.mjs",
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "auth": {
    "predeploy": [
      "node scripts/firebase-guard.mjs"
    ],
    "providers": {
      "anonymous": false,
      "emailPassword": true
    }
  }
}
