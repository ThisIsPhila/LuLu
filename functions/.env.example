# Privacy processing stays disabled unless deliberately opted in.
PRIVACY_PROVIDER=disabled
# Decisions uses the fixed gpt-6-luna model. For optional Responses, set
# OPENAI_RESPONSES_MODEL to an explicitly selected compatible model.
# OPENAI_RESPONSES_MODEL=

# OPENAI_API_KEY is server-only. Use an uncommitted local secret source or
# Firebase Secret Manager after the approved deployment binding is installed.
# Never commit a real key in an env file.
